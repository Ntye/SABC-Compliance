[Unit]
Description=SABC Compliance Detection Agent (config-change watch + evidence)
Documentation=https://github.com/ntye/sabc-compliance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Requires Python 3.7+ (agent.py uses `from __future__ import annotations`).
# On RHEL/Alma/Rocky 8 the system python3 is 3.6 and will crash the agent with
# "SyntaxError: future feature annotations is not defined" — point this at
# python3.11 (or newer) there. Ansible enrolment renders this line dynamically
# with the interpreter it resolves on the node; this static default suits
# distros whose /usr/bin/python3 is already 3.7+.
ExecStart=/usr/bin/python3 /usr/local/lib/compliance-agent/agent.py --config /etc/compliance-agent/config.yaml
Restart=always
RestartSec=5
User=root

# Hardening — the agent only reads watched paths and writes its own state/spool.
NoNewPrivileges=yes
ProtectHome=read-only
ReadWritePaths=/var/lib/compliance-agent /var/spool/compliance-agent
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
