# SABC Compliance Platform — copy to .env and fill values

PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DB_PATH=./data/platform.db
SSH_KEY_PATH=./keys/ansible_id_rsa
ANSIBLE_DIR=./ansible

# JWT
# Signing secret for user session tokens. If left as this placeholder (or blank,
# or under 32 chars) the platform generates a strong random secret on first boot
# and persists it, so tokens can never be forged with a known key — but SET YOUR
# OWN >=32-char value in production so it is stable and under your control.
JWT_SECRET=change-me-in-production-use-random-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Master key that encrypts secrets at rest (Puppet console password, detection
# webhook key, the auto JWT secret). Leave blank to auto-generate a key stored
# 0600 next to the database; SET IT in production so the key lives off the DB
# host and stays portable across hosts. Any passphrase works — it is hashed.
MASTER_KEY=

# Login brute-force protection: lock a (username, client-IP) pair after this
# many failed attempts within the window, for the lockout duration (seconds).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Puppet — leave PUPPET_MASTER_HOST blank for stub mode
# PUPPET_EDITION: "enterprise" (PE Advanced; uses the commercial RBAC + Node
# Classifier APIs) or "core" (open-source Puppet; classifies via an External
# Node Classifier deployed over SSH — the no-cost production path). Can also be
# switched at runtime from the console (POST /api/infrastructure/puppet-edition).
PUPPET_EDITION=enterprise
PUPPET_MASTER_HOST=
PUPPET_MASTER_PORT=8143
PUPPET_RBAC_PORT=4433
PUPPET_ADMIN_USER=admin
PUPPET_ADMIN_PASS=
PUPPET_TOKEN_LIFETIME=1296000
PUPPET_TOKEN_ROTATE_SECONDS=43200
# Puppet Core ENC (only used when PUPPET_EDITION=core)
PUPPET_CORE_ENC_DIR=/etc/puppetlabs/puppet/enc
PUPPET_CORE_SSH_USER=root
PUPPET_CORE_DEFAULT_ENVIRONMENT=production

# Detection agent webhook (custom detection plane)
# Comma/space-separated IPs or CIDRs allowed to POST /api/webhooks/detection.
# Leave blank to allow any source that presents a valid API key.
DETECTION_WEBHOOK_SOURCE_IP=
# Shared API key the detection agents present (X-API-Key). Leave blank to keep
# the webhook DISABLED; it is auto-generated (and stored in platform config)
# the first time a detection agent is installed from the console.
DETECTION_WEBHOOK_API_KEY=

COLLECTOR_INTERVAL_SECONDS=300
SWAGGER_ENABLED=true
